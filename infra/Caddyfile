{$APP_DOMAIN:localhost} {
  encode zstd gzip
  handle /api/* { reverse_proxy backend:8080 }
  handle /actuator/health/* { reverse_proxy backend:8080 }
  handle { reverse_proxy frontend:80 }
  header { Strict-Transport-Security "max-age=31536000; includeSubDomains" -Server }
  log { output file /var/log/caddy/access.log { roll_size 20MiB roll_keep 7 } }
}
